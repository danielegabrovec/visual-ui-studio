{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "jsx": "react-jsx",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@renderer/*": ["src/renderer/src/*"],
      "@codegen/*": ["src/workers/codegen-worker/*"]
    }
  },
  "include": [
    "package.json",
    "electron.vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "src/shared/**/*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/workers/**/*",
    "tests/**/*"
  ],
  "exclude": [
    "tests/automation.test.ts",
    "tests/blueprint-script.test.ts",
    "tests/browser-studio.test.ts",
    "tests/css-pro-controls.test.ts",
    "tests/three-studio.test.ts"
  ]
}
